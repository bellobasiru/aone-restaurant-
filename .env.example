# Copy this file to .env and fill in the values from your Firebase project:
# Firebase Console > Project Settings > General > "Your apps" > Web app > SDK setup and configuration
#
# These are public identifiers, not secret keys — see README.md for why
# that's fine as long as your Firestore/Storage security rules are correct.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=